# Public source allowlist. Local device evidence, SDKs and signing keys stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/SHA256SUMS.txt
!/app/
!/scripts/
!/docs/
!/design/

/app/*
!/app/AndroidManifest.xml
!/app/src/
!/app/res/
!/app/tests/
!/app/assets/

/scripts/*
!/scripts/build.py
/docs/*
!/docs/BUILDING.md
!/docs/VERIFICATION-v1.0.3.md
!/docs/images/
!/docs/releases/
/design/*
!/design/icon/
/design/icon/*
!/design/icon/earbuds-line-icon.svg
!/design/icon/earbuds-line-icon.png

**/__pycache__/
*.pyc
*.apk
*.idsig
*.keystore
*.jks
*.p12
*.pem
*.key
.env
.env.*
local.properties

# Brand artwork is private; the public build uses original vector placeholders.
/app/assets/models/freebuds_6i/
/docs/images/freebuds-6i-loop.gif
